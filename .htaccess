# Semua permintaan diteruskan ke folder public/ (alamat tetap /pubchecker).
# File di folder utama — .env, vendor/, storage/, app/, dll. — tidak bisa dibuka lewat browser:
# mis. /pubchecker/.env dicari sebagai public/.env (tidak ada) → 404 dari aplikasi.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Cadangan bila mod_rewrite tidak aktif: tolak semua akses langsung ke folder utama
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

php_value max_execution_time 300
php_value max_input_time 300
